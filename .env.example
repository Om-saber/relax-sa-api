# ---------------------------------------------------------------------------
# Let's Relax API - Environment variables
# Copy to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL
# Local docker-compose default:
DATABASE_URL=postgresql://relax:relax@localhost:5432/relax?schema=public

# JWT (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_REFRESH_TTL_DAYS=30

# CORS: comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- OTP -------------------------------------------------------------------
# DEV ONLY: returns the OTP in the API response and logs it to stdout.
# Defaults to false. The app refuses to start with true when NODE_ENV=production.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=3
# Extra secret mixed into the OTP hash (generate with: openssl rand -base64 32)
OTP_PEPPER=replace-me-with-a-random-pepper

# --- SMS -------------------------------------------------------------------
# console | taqnyat | msegat
# console is rejected when NODE_ENV=production, and the chosen provider's
# credentials below are required there.
SMS_PROVIDER=console
SMS_SENDER_NAME=Relax-Spa
# Taqnyat
TAQNYAT_BEARER_TOKEN=
# Msegat
MSEGAT_USERNAME=
MSEGAT_API_KEY=

# --- Swagger ---------------------------------------------------------------
# Defaults to false; enable explicitly (local dev only, ideally).
SWAGGER_ENABLED=true

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@relax.sa
# Dev only. In production the seed requires a strong value (12+ chars) and
# the app refuses to start if this is left as ChangeMe123!.
SEED_ADMIN_PASSWORD=ChangeMe123!
