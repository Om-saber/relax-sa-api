// ---------------------------------------------------------------------------
// Let's Relax - Prisma schema
//
// Conventions
//  - Money is stored as Decimal(10,2) in SAR.
//  - Prices are VAT-inclusive; VAT is derived on the invoice (ASSUMPTIONS.md).
//  - Every business table has createdAt / updatedAt; user-facing soft delete
//    only where required (User, Booking, Order).
//  - Booking = scheduled event (when / where / who).
//    Order   = financial container (what was bought / discounts / payments).
//  - Double-booking protection uses an EXCLUDE constraint on real time ranges
//    (see prisma/sql/02-booking-overlap.sql), not on slot ids.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums ---------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum StaffStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

enum ClientTier {
  SILVER
  GOLD
  VIP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ON_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingType {
  INDIVIDUAL
  GROUP
}

enum BookingSource {
  WEBSITE
  ADMIN
  PHONE
  WHATSAPP
  WALK_IN
}

enum PaymentMethod {
  CASH
  CARD
  MADA
  APPLE_PAY
  TABBY
  TAMARA
  BANK_TRANSFER
  POINTS
  WALLET
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentProvider {
  MANUAL
  MOYASAR
  TABBY
  TAMARA
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum OrderItemKind {
  SERVICE
  PACKAGE
  GIFT_CARD
  PRODUCT
}

enum PaymentLinkStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  ALL
  SERVICE
  CATEGORY
  PACKAGE
  CITY
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum GiftCardTxType {
  ISSUE
  REDEEM
  REFUND
  ADJUST
}

enum WalletTxType {
  CREDIT
  DEBIT
  REFUND
  ADJUST
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ----------------------------- Identity ------------------------------------

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  passwordHash    String?
  name            String
  role            UserRole  @default(CUSTOMER)
  isActive        Boolean   @default(true)
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  preferredLocale String    @default("ar")
  lastLoginAt     DateTime?
  tokenVersion    Int       @default(0)
  twoFactorSecret String?

  roleId   String?
  roleRef  Role?   @relation(fields: [roleId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  clientProfile ClientProfile?
  staffProfile  StaffProfile?
  refreshTokens RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  reviews       Review[]
  assignedTickets Ticket[] @relation("TicketAssignee")
  createdTickets  Ticket[] @relation("TicketCreator")
  clientTickets   Ticket[] @relation("TicketClient")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([isActive])
  @@index([branchId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean  @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid())
  key   String @unique
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ----------------------------- Geography -----------------------------------

model City {
  id               String  @id @default(uuid())
  key              String  @unique
  nameAr           String
  nameEn           String
  isActive         Boolean @default(true)
  deliveryFee      Decimal @default(0) @db.Decimal(10, 2)
  surgeMultiplier  Decimal @default(1) @db.Decimal(5, 2)
  operatingHours   String?
  maxDailyCapacity Int     @default(0)

  branches      Branch[]
  coverageAreas CoverageArea[]
  bookings      Booking[]
  cityPrices    ServiceCityPrice[]
  blackouts     BlackoutDate[]
  addresses     Address[]
  teams         Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cities")
}

model Branch {
  id          String  @id @default(uuid())
  cityId      String
  nameAr      String
  nameEn      String
  managerName String?
  phone       String?
  isActive    Boolean @default(true)

  city         City           @relation(fields: [cityId], references: [id])
  staff        StaffBranch[]
  bookings     Booking[]
  teams        Team[]
  workingHours WorkingHours[]
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@map("branches")
}

model CoverageArea {
  id        String  @id @default(uuid())
  cityId    String
  nameAr    String
  nameEn    String
  isActive  Boolean @default(true)
  // Optional geo fence. A district name is the primary launch check; these
  // coordinates are used for map display and a secondary distance check.
  centerLat Decimal? @db.Decimal(10, 7)
  centerLng Decimal? @db.Decimal(10, 7)
  radiusKm  Decimal? @db.Decimal(6, 2)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@map("coverage_areas")
}

model TimeSlot {
  id        String  @id @default(uuid())
  key       String  @unique
  labelAr   String
  labelEn   String
  startTime String
  endTime   String
  period    String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  bookings Booking[]

  @@map("time_slots")
}

model BlackoutDate {
  id     String   @id @default(uuid())
  title  String
  date   DateTime @db.Date
  cityId String?
  active Boolean  @default(true)

  city City? @relation(fields: [cityId], references: [id])

  @@index([date])
  @@map("blackout_dates")
}

// ----------------------------- Catalog -------------------------------------

model ServiceCategory {
  id        String  @id @default(uuid())
  key       String  @unique
  nameAr    String
  nameEn    String
  icon      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  services Service[]

  @@map("service_categories")
}

model Service {
  id               String  @id @default(uuid())
  categoryId       String
  slug             String  @unique
  titleAr          String
  titleEn          String
  descriptionAr    String?
  descriptionEn    String?
  price            Decimal @db.Decimal(10, 2)
  originalPrice    Decimal? @db.Decimal(10, 2)
  durationMinutes  Int
  maxBeneficiaries Int     @default(1)
  badgeAr          String?
  badgeEn          String?
  imageUrl         String?
  rating           Decimal @default(5) @db.Decimal(3, 2)
  reviewsCount     Int     @default(0)
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  category    ServiceCategory    @relation(fields: [categoryId], references: [id])
  addons      ServiceAddon[]
  staff       StaffService[]
  cityPrices  ServiceCityPrice[]
  items       BookingItem[]
  variants    ServiceVariant[]
  packageItems PackageItem[]
  favorites   Favorite[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model ServiceVariant {
  id              String  @id @default(uuid())
  serviceId       String
  labelAr         String
  labelEn         String?
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  items   BookingItem[]

  @@unique([serviceId, durationMinutes])
  @@index([serviceId])
  @@map("service_variants")
}

model ServiceAddon {
  id              String  @id @default(uuid())
  serviceId       String?
  nameAr          String
  nameEn          String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int     @default(0)
  isActive        Boolean @default(true)

  service Service? @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("service_addons")
}

model ServiceCityPrice {
  serviceId String
  cityId    String
  price     Decimal @db.Decimal(10, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([serviceId, cityId])
  @@map("service_city_prices")
}

model Package {
  id               String  @id @default(uuid())
  slug             String  @unique
  titleAr          String
  titleEn          String?
  descriptionAr    String?
  descriptionEn    String?
  imageUrl         String?
  price            Decimal @db.Decimal(10, 2)
  originalPrice    Decimal? @db.Decimal(10, 2)
  durationMinutes  Int
  maxBeneficiaries Int     @default(1)
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  items     PackageItem[]
  bookings  Booking[]
  favorites Favorite[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model PackageItem {
  id              String @id @default(uuid())
  packageId       String
  serviceId       String
  quantity        Int    @default(1)
  durationMinutes Int

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([packageId, serviceId])
  @@map("package_items")
}

// ----------------------------- Staff ---------------------------------------

model StaffProfile {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  staffCode              String      @unique
  roleTitle              String
  cityId                 String?
  commissionRate         Decimal     @default(20) @db.Decimal(5, 2)
  status                 StaffStatus @default(AVAILABLE)
  rating                 Decimal     @default(5) @db.Decimal(3, 2)
  reviewsCount           Int         @default(0)
  completedBookingsCount Int         @default(0)
  maxDailyBookings       Int         @default(0)
  shiftStart             String?
  shiftEnd               String?
  isPartOfTeam           Boolean     @default(false)
  avatarUrl              String?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       StaffService[]
  branches       StaffBranch[]
  offDays        StaffOffDay[]
  bookings       Booking[]
  reviews        Review[]
  commissions    Commission[]
  payouts        Payout[]
  teams          TeamMember[]
  leaves         StaffLeave[]
  blockedTimes   StaffBlockedTime[]
  workingHours   WorkingHours[]
  beneficiaries  BookingBeneficiary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_profiles")
}

model StaffService {
  staffId   String
  serviceId String

  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model StaffBranch {
  staffId  String
  branchId String

  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
  @@map("staff_branches")
}

/// Legacy recurring weekday off. Prefer `StaffLeave` for dated ranges.
model StaffOffDay {
  id      String @id @default(uuid())
  staffId String
  weekday Int // 0 = Sunday ... 6 = Saturday

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, weekday])
  @@map("staff_off_days")
}

model StaffLeave {
  id      String      @id @default(uuid())
  staffId String
  startAt DateTime
  endAt   DateTime
  reason  String?
  status  LeaveStatus @default(APPROVED)

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([staffId, startAt])
  @@map("staff_leaves")
}

model StaffBlockedTime {
  id          String   @id @default(uuid())
  staffId     String?
  teamId      String?
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdById String?

  staff StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  team  Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([staffId, startAt])
  @@index([teamId, startAt])
  @@map("staff_blocked_times")
}

model WorkingHours {
  id        String  @id @default(uuid())
  staffId   String?
  branchId  String?
  weekday   Int // 0 = Sunday ... 6 = Saturday
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  staff  StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
  @@index([branchId, weekday])
  @@map("working_hours")
}

model Team {
  id               String  @id @default(uuid())
  code             String  @unique
  nameAr           String
  nameEn           String?
  cityId           String?
  branchId         String?
  maxDailyBookings Int     @default(0)
  isActive         Boolean @default(true)

  city         City?              @relation(fields: [cityId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  members      TeamMember[]
  bookings     Booking[]
  blockedTimes StaffBlockedTime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@map("teams")
}

model TeamMember {
  teamId String
  staffId String
  isLead Boolean @default(false)

  team  Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([teamId, staffId])
  @@map("team_members")
}

// ----------------------------- Clients -------------------------------------

model ClientProfile {
  id              String     @id @default(uuid())
  userId          String     @unique
  tier            ClientTier @default(SILVER)
  notes           String?
  totalBookings   Int        @default(0)
  totalSpent      Decimal    @default(0) @db.Decimal(10, 2)
  lastBookingDate DateTime?  @db.Date

  // Legacy single address kept as a snapshot. New addresses live in `Address`.
  district        String?
  address         String?
  cityId          String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  orders    Order[]
  addresses Address[]
  wallet    Wallet?
  loyalty   LoyaltyAccount?
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_profiles")
}

model Address {
  id            String       @id @default(uuid())
  clientId      String
  label         AddressLabel @default(HOME)
  recipientName String?
  phone         String?
  cityId        String
  district      String
  street        String
  buildingNo    String?
  notes         String?
  lat           Decimal?     @db.Decimal(10, 7)
  lng           Decimal?     @db.Decimal(10, 7)
  isDefault     Boolean      @default(false)

  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  city     City          @relation(fields: [cityId], references: [id])
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("addresses")
}

// ----------------------------- Bookings ------------------------------------

model Booking {
  id                 String        @id @default(uuid())
  bookingNumber      String        @unique
  clientId           String?
  customerName       String
  customerPhone      String
  cityId             String
  branchId           String?
  district           String?
  address            String?
  addressId          String?
  date               DateTime      @db.Date
  timeSlotId         String?
  // Real scheduling window. This is the source of truth for conflicts.
  startAt            DateTime?     @db.Timestamptz(3)
  endAt              DateTime?     @db.Timestamptz(3)
  bookingType        BookingType   @default(INDIVIDUAL)
  beneficiariesCount Int           @default(1)
  source             BookingSource @default(WEBSITE)
  status             BookingStatus @default(PENDING)

  // Money snapshot (VAT-inclusive prices). Mirrored on the parent Order.
  subtotal         Decimal @db.Decimal(10, 2)
  discountAmount   Decimal @default(0) @db.Decimal(10, 2)
  vatAmount        Decimal @default(0) @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)
  paymentMethod    PaymentMethod?
  paymentStatus    PaymentStatus @default(UNPAID)

  notes                   String?
  specialistId            String?
  teamId                  String?
  packageId               String?
  orderId                 String?
  commissionRateSnapshot  Decimal? @db.Decimal(5, 2)
  commissionAmount        Decimal? @db.Decimal(10, 2)

  createdById  String?
  cancelledAt  DateTime?
  cancelReason String?

  client      ClientProfile? @relation(fields: [clientId], references: [id])
  city        City           @relation(fields: [cityId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  addressRef  Address?       @relation(fields: [addressId], references: [id])
  timeSlot    TimeSlot?      @relation(fields: [timeSlotId], references: [id])
  specialist  StaffProfile?  @relation(fields: [specialistId], references: [id])
  team        Team?          @relation(fields: [teamId], references: [id])
  package     Package?       @relation(fields: [packageId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])

  items         BookingItem[]
  beneficiaries BookingBeneficiary[]
  statusHistory BookingStatusHistory[]
  payments      Payment[]
  invoice       Invoice?
  giftCardTxs   GiftCardTransaction[]
  review        Review?
  commission    Commission?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date, timeSlotId])
  @@index([specialistId, startAt])
  @@index([teamId, startAt])
  @@index([status])
  @@index([customerPhone])
  @@index([cityId])
  @@index([orderId])
  @@map("bookings")
}

model BookingBeneficiary {
  id        String  @id @default(uuid())
  bookingId String
  name      String
  phone     String?
  notes     String?
  staffId   String?

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   StaffProfile? @relation(fields: [staffId], references: [id])
  items   BookingItem[]

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_beneficiaries")
}

model BookingItem {
  id              String  @id @default(uuid())
  bookingId       String
  serviceId       String?
  variantId       String?
  beneficiaryId   String?
  titleAr         String
  titleEn         String?
  unitPrice       Decimal @db.Decimal(10, 2)
  quantity        Int     @default(1)
  durationMinutes Int     @default(0)
  total           Decimal @db.Decimal(10, 2)

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service?            @relation(fields: [serviceId], references: [id])
  variant     ServiceVariant?     @relation(fields: [variantId], references: [id])
  beneficiary BookingBeneficiary? @relation(fields: [beneficiaryId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String?
  note        String?
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Commission {
  id        String           @id @default(uuid())
  bookingId String           @unique
  staffId   String
  rate      Decimal          @db.Decimal(5, 2)
  amount    Decimal          @db.Decimal(10, 2)
  status    CommissionStatus @default(PENDING)
  payoutId  String?

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   StaffProfile @relation(fields: [staffId], references: [id])
  payout  Payout?      @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, status])
  @@map("commissions")
}

model Payout {
  id          String       @id @default(uuid())
  staffId     String
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  totalAmount Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?

  staff       StaffProfile @relation(fields: [staffId], references: [id])
  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, status])
  @@map("payouts")
}

// ----------------------------- Orders --------------------------------------

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  clientId      String?
  customerName  String
  customerPhone String
  status        OrderStatus @default(PENDING_PAYMENT)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  walletAmount   Decimal @default(0) @db.Decimal(10, 2)
  pointsAmount   Decimal @default(0) @db.Decimal(10, 2)
  vatAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  paidAmount     Decimal @default(0) @db.Decimal(10, 2)
  currency       String  @default("SAR")

  couponId    String?
  promotionId String?
  notes       String?
  createdById String?

  client       ClientProfile?    @relation(fields: [clientId], references: [id])
  bookings     Booking[]
  items        OrderItem[]
  payments     Payment[]
  invoices     Invoice[]
  paymentLinks PaymentLink[]
  redemptions  CouponRedemption[]
  review       Review?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String        @id @default(uuid())
  orderId   String
  kind      OrderItemKind @default(SERVICE)
  serviceId String?
  packageId String?
  variantId String?
  titleAr   String
  titleEn   String?
  unitPrice Decimal       @db.Decimal(10, 2)
  quantity  Int           @default(1)
  total     Decimal       @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model PaymentLink {
  id          String            @id @default(uuid())
  token       String            @unique
  orderId     String
  amount      Decimal           @db.Decimal(10, 2)
  status      PaymentLinkStatus @default(ACTIVE)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdById String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("payment_links")
}

// ----------------------------- Payments ------------------------------------

model Payment {
  id             String          @id @default(uuid())
  bookingId      String?
  orderId        String?
  amount         Decimal         @db.Decimal(10, 2)
  refundedAmount Decimal         @default(0) @db.Decimal(10, 2)
  currency       String          @default("SAR")
  method         PaymentMethod
  provider       PaymentProvider @default(MANUAL)
  status         PaymentStatus   @default(UNPAID)
  providerRef    String?         @unique
  idempotencyKey String?         @unique
  rawPayload     Json?
  paidAt         DateTime?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id             String   @id @default(uuid())
  bookingId      String?  @unique
  orderId        String?  @unique
  invoiceNumber  String   @unique
  sequenceNumber Int?
  vatNumber      String?
  subtotal       Decimal  @db.Decimal(10, 2)
  vatAmount      Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  zatcaQr        String?
  issuedAt       DateTime @default(now())
  pdfUrl         String?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Coupon {
  id        String       @id @default(uuid())
  code      String       @unique
  type      DiscountType @default(PERCENTAGE)
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal      @default(0) @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean      @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  orderId        String   @unique
  clientId       String?
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_redemptions")
}

model Promotion {
  id             String         @id @default(uuid())
  code           String?        @unique
  titleAr        String
  titleEn        String?
  descriptionAr  String?
  type           DiscountType   @default(PERCENTAGE)
  value          Decimal        @db.Decimal(10, 2)
  scope          PromotionScope @default(ALL)
  categoryId     String?
  serviceId      String?
  packageId      String?
  cityId         String?
  minOrder       Decimal        @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?       @db.Decimal(10, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usedCount      Int            @default(0)
  perClientLimit Int            @default(1)
  imageUrl       String?
  isActive       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model GiftCard {
  id            String         @id @default(uuid())
  code          String         @unique
  initialAmount Decimal        @db.Decimal(10, 2)
  balance       Decimal        @db.Decimal(10, 2)
  status        GiftCardStatus @default(ACTIVE)
  expiresAt     DateTime?
  purchaserId   String?
  recipientName String?
  message       String?
  design        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transactions GiftCardTransaction[]

  @@index([status])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String         @id @default(uuid())
  giftCardId String
  bookingId  String?
  type       GiftCardTxType
  amount     Decimal        @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime       @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

// ----------------------------- Loyalty & wallet ----------------------------

model Wallet {
  id       String  @id @default(uuid())
  clientId String  @unique
  balance  Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("SAR")

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id           String       @id @default(uuid())
  walletId     String
  type         WalletTxType
  amount       Decimal      @db.Decimal(10, 2)
  balanceAfter Decimal      @db.Decimal(10, 2)
  reference    String?
  note         String?
  createdAt    DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model LoyaltyAccount {
  id             String     @id @default(uuid())
  clientId       String     @unique
  pointsBalance  Int        @default(0)
  lifetimePoints Int        @default(0)
  tier           ClientTier @default(SILVER)

  client       ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id           String        @id @default(uuid())
  accountId    String
  type         LoyaltyTxType
  points       Int
  balanceAfter Int
  orderId      String?
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime      @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

model Favorite {
  id        String   @id @default(uuid())
  clientId  String
  serviceId String?
  packageId String?
  createdAt DateTime @default(now())

  client  ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package Package?      @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([clientId, serviceId])
  @@unique([clientId, packageId])
  @@map("favorites")
}

// ----------------------------- Engagement ----------------------------------

model Review {
  id          String       @id @default(uuid())
  bookingId   String       @unique
  orderId     String?      @unique
  clientId    String?
  staffId     String?
  rating      Int
  comment     String?
  status      ReviewStatus @default(PENDING)
  publishedAt DateTime?

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order   Order?        @relation(fields: [orderId], references: [id])
  client  User?         @relation(fields: [clientId], references: [id])
  staff   StaffProfile? @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("reviews")
}

model Ticket {
  id              String       @id @default(uuid())
  ticketNumber    String       @unique
  clientId        String?
  customerName    String
  customerPhone   String
  category        String?
  priority        Priority     @default(MEDIUM)
  status          TicketStatus @default(NEW)
  subject         String
  description     String
  resolutionNotes String?
  assignedToId    String?
  createdById     String?
  resolvedAt      DateTime?

  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy  User?           @relation("TicketCreator", fields: [createdById], references: [id])
  client     User?           @relation("TicketClient", fields: [clientId], references: [id])
  messages   TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String?
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ----------------------------- CMS & settings ------------------------------

model CmsBlock {
  id        String  @id @default(uuid())
  key       String  @unique
  titleAr   String?
  titleEn   String?
  contentAr String?
  contentEn String?
  imageUrl  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("cms_blocks")
}

model CmsPage {
  id               String   @id @default(uuid())
  slug             String   @unique
  titleAr          String
  titleEn          String?
  contentAr        String
  contentEn        String?
  metaTitleAr      String?
  metaDescriptionAr String?
  isPublished      Boolean  @default(true)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("cms_pages")
}

model Faq {
  id         String  @id @default(uuid())
  category   String?
  questionAr String
  questionEn String?
  answerAr   String
  answerEn   String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model ContactMessage {
  id          String               @id @default(uuid())
  name        String
  phone       String
  email       String?
  subject     String?
  message     String
  status      ContactMessageStatus @default(NEW)
  handledById String?
  replyNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model GalleryItem {
  id        String  @id @default(uuid())
  imageUrl  String
  titleAr   String?
  titleEn   String?
  category  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("gallery_items")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ----------------------------- Ops -----------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model NotificationTemplate {
  id       String              @id @default(uuid())
  key      String
  channel  NotificationChannel
  locale   String              @default("ar")
  subject  String?
  body     String
  isActive Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, channel, locale])
  @@map("notification_templates")
}

model Notification {
  id          String             @id @default(uuid())
  userId      String?
  channel     NotificationChannel
  template    String
  recipient   String?
  payload     Json?
  status      NotificationStatus @default(QUEUED)
  providerRef String?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("notifications")
}
